# ═══════════════════════════════════════════
# Real-Time Recommendation Engine
# Copy this file to .env and fill in values
# ═══════════════════════════════════════════

# ── General ───────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── Database (PostgreSQL) ─────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rec_engine
DATABASE_USER=rec_user
DATABASE_PASSWORD=rec_pass
DATABASE_URL=postgresql://rec_user:rec_pass@localhost:5432/rec_engine
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_CONNECT_TIMEOUT=10
DATABASE_COMMAND_TIMEOUT=30
DATABASE_SSL_MODE=prefer
# DATABASE_SSL_CERT=
# DATABASE_SSL_KEY=
# DATABASE_SSL_ROOT_CERT=

# ── Redis ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_URL=redis://localhost:6379/0

# Redis Cluster
REDIS_CLUSTER_ENABLED=false
# REDIS_CLUSTER_NODES=host1:6379,host2:6379

# Redis TTL (seconds)
REDIS_USER_FEATURES_TTL=3600
REDIS_ITEM_FEATURES_TTL=7200
REDIS_RECOMMENDATION_CACHE_TTL=300
REDIS_MODEL_CACHE_TTL=1800

# ── Kafka ─────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=rec-engine
KAFKA_CONSUMER_GROUP=rec-engine-consumer
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_MAX_POLL_RECORDS=1000
KAFKA_COMPRESSION_TYPE=snappy

# Kafka Topics
KAFKA_USER_EVENTS_TOPIC=user-events
KAFKA_INTERACTION_EVENTS_TOPIC=interaction-events
KAFKA_FEATURE_UPDATES_TOPIC=feature-updates
KAFKA_MODEL_UPDATES_TOPIC=model-updates

# Kafka Schema Registry
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Kafka Security
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ── Model ─────────────────────────────────
MODEL_EMBEDDING_DIM=128
MODEL_HIDDEN_LAYERS=512,256,128
MODEL_DROPOUT_RATE=0.2
MODEL_LEARNING_RATE=0.001
MODEL_BATCH_SIZE=2048
MODEL_NUM_EPOCHS=100
MODEL_EARLY_STOPPING_PATIENCE=10

# Negative Sampling
MODEL_NUM_NEGATIVES=5
MODEL_NEGATIVE_SAMPLING_STRATEGY=uniform

# Regularization
MODEL_L2_REGULARIZATION=1e-5
MODEL_EMBEDDING_L2_REGULARIZATION=1e-6

# Model Paths
MODEL_REGISTRY_PATH=/models
MODEL_CHECKPOINT_DIR=/checkpoints

# ANN Index
MODEL_INDEX_TYPE=scann
MODEL_NUM_CANDIDATES=100
MODEL_FINAL_K=10

# ScaNN
MODEL_SCANN_NUM_LEAVES=100
MODEL_SCANN_NUM_LEAVES_TO_SEARCH=10
MODEL_SCANN_QUANTIZATION_BITS=8

# FAISS
MODEL_FAISS_INDEX_TYPE=IVF_PQ
MODEL_FAISS_NLIST=1000
MODEL_FAISS_M=64
MODEL_FAISS_NBITS=8

# ── Training ──────────────────────────────
TRAINING_BACKEND=nccl
TRAINING_WORLD_SIZE=1
TRAINING_RANK=0
TRAINING_LOCAL_RANK=0
TRAINING_MASTER_ADDR=localhost
TRAINING_MASTER_PORT=12355
TRAINING_USE_AMP=true
TRAINING_AMP_OPT_LEVEL=O1
TRAINING_GRADIENT_ACCUMULATION_STEPS=1
TRAINING_SAVE_EVERY_N_STEPS=1000
TRAINING_SAVE_TOP_K=3
TRAINING_MONITOR_METRIC=val_auc
TRAINING_NUM_WORKERS=4
TRAINING_PIN_MEMORY=true
TRAINING_PERSISTENT_WORKERS=true
TRAINING_PROFILE_MEMORY=false
TRAINING_PROFILE_STEPS=100

# ── API ───────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false
API_LOG_LEVEL=info

# Rate Limiting
API_RATE_LIMIT_REQUESTS=1000
API_RATE_LIMIT_WINDOW=60

# Request Timeouts
API_REQUEST_TIMEOUT=30
API_READ_TIMEOUT=60
API_WRITE_TIMEOUT=60

# Circuit Breaker
API_CIRCUIT_BREAKER_THRESHOLD=5
API_CIRCUIT_BREAKER_TIMEOUT=60

# Authentication (JWT)
API_JWT_SECRET_KEY=your-secret-key-change-me
API_JWT_ALGORITHM=HS256
API_JWT_EXPIRATION=3600

# CORS
API_CORS_ORIGINS=*
API_CORS_METHODS=GET,POST
API_CORS_HEADERS=*

# ── Monitoring ────────────────────────────
MONITORING_PROMETHEUS_PORT=9090
MONITORING_GRAFANA_PORT=3000
MONITORING_METRICS_INTERVAL=15

# Logging
MONITORING_LOG_LEVEL=INFO
MONITORING_LOG_FORMAT=json
# MONITORING_LOG_FILE=

# Tracing
# MONITORING_JAEGER_ENDPOINT=http://localhost:14268/api/traces
MONITORING_TRACING_SAMPLE_RATE=0.1

# Alerting
# MONITORING_ALERT_WEBHOOK_URL=
MONITORING_LATENCY_P95_THRESHOLD=100.0
MONITORING_ERROR_RATE_THRESHOLD=0.01
MONITORING_QPS_THRESHOLD=10000.0
MONITORING_MEMORY_USAGE_THRESHOLD=0.8
MONITORING_CPU_USAGE_THRESHOLD=0.8

# Drift Detection
MONITORING_DRIFT_DETECTION_INTERVAL=300
MONITORING_PSI_THRESHOLD=0.1
MONITORING_KL_THRESHOLD=0.1
MONITORING_CTR_WINDOW_SIZE=10000

# ── Feature Store ─────────────────────────
FEATURE_STORE_ONLINE_STORE=redis
FEATURE_STORE_OFFLINE_STORE=postgres
FEATURE_STORE_DEFINITIONS_PATH=features/
FEATURE_STORE_SYNC_INTERVAL=300
FEATURE_STORE_BATCH_SIZE=1000
FEATURE_STORE_ENABLE_POINT_IN_TIME=true
FEATURE_STORE_MAX_LOOKBACK_DAYS=30
FEATURE_STORE_ENABLE_VERSIONING=true
FEATURE_STORE_MAX_VERSIONS=10

# ── Experiments ───────────────────────────
EXPERIMENT_REGISTRY_PATH=/experiments
EXPERIMENT_DEFAULT_CONTROL_SPLIT=0.5
EXPERIMENT_DEFAULT_TREATMENT_SPLIT=0.5
EXPERIMENT_MIN_SAMPLE_SIZE=1000
EXPERIMENT_CONFIDENCE_LEVEL=0.95
EXPERIMENT_STATISTICAL_POWER=0.8
EXPERIMENT_PRIMARY_METRIC=ctr
EXPERIMENT_SECONDARY_METRICS=conversion_rate,engagement_time,return_rate
