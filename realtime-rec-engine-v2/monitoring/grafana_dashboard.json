{
  "dashboard": {
    "title": "Real-time Recommendation Engine",
    "uid": "rec-engine",
    "tags": ["rec-engine", "recommendations", "ml-platform", "production"],
    "timezone": "utc",
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (req/s)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(rec_engine_requests_total[1m])) by (endpoint, status)",
            "legendFormat": "{{endpoint}} - {{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 2,
        "title": "Latency p50 / p95 / p99",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(rec_engine_request_latency_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "p50 - {{endpoint}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(rec_engine_request_latency_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "p95 - {{endpoint}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(rec_engine_request_latency_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "p99 - {{endpoint}}",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.1, "color": "yellow"},
                {"value": 0.2, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Error Rate by Endpoint",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(rec_engine_errors_total[5m])) by (endpoint, error_type) / sum(rate(rec_engine_requests_total[5m])) by (endpoint)",
            "legendFormat": "{{endpoint}} - {{error_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.005, "color": "yellow"},
                {"value": 0.01, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Auth Failures & Authz Denials",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(rec_engine_auth_failures_total[5m])) by (reason)",
            "legendFormat": "Auth Fail - {{reason}}",
            "refId": "A"
          },
          {
            "expr": "sum(rate(rec_engine_authz_denials_total[5m])) by (required_scope)",
            "legendFormat": "Authz Deny - {{required_scope}}",
            "refId": "B"
          },
          {
            "expr": "sum(rate(rec_engine_rate_limit_exceeded_total[5m])) by (scope)",
            "legendFormat": "Rate Limit - {{scope}}",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        }
      },
      {
        "id": 5,
        "title": "Recommendation Latency (p50/p95/p99)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(rec_engine_recommendation_latency_seconds_bucket[5m])) by (le, cache_hit))",
            "legendFormat": "p50 - cache={{cache_hit}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(rec_engine_recommendation_latency_seconds_bucket[5m])) by (le, cache_hit))",
            "legendFormat": "p95 - cache={{cache_hit}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(rec_engine_recommendation_latency_seconds_bucket[5m])) by (le, cache_hit))",
            "legendFormat": "p99 - cache={{cache_hit}}",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.05, "color": "yellow"},
                {"value": 0.1, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Cache Hit Rate",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 16, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(rec_engine_cache_hits_total[5m])) / (sum(rate(rec_engine_cache_hits_total[5m])) + sum(rate(rec_engine_cache_misses_total[5m])))",
            "legendFormat": "Cache Hit Rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.5, "color": "yellow"},
                {"value": 0.7, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Recommendations Generated (req/s)",
        "type": "timeseries",
        "gridPos": {"x": 18, "y": 16, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(rec_engine_recommendations_total[1m])) by (experiment_id, cache_hit)",
            "legendFormat": "exp={{experiment_id}} cache={{cache_hit}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        }
      },
      {
        "id": 8,
        "title": "Circuit Breaker Status",
        "type": "stat",
        "gridPos": {"x": 0, "y": 24, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rec_engine_circuit_breaker_state",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "Closed", "color": "green"}}},
              {"type": "value", "options": {"1": {"text": "Half-Open", "color": "yellow"}}},
              {"type": "value", "options": {"2": {"text": "Open", "color": "red"}}}
            ]
          }
        }
      },
      {
        "id": 9,
        "title": "Active Connections",
        "type": "stat",
        "gridPos": {"x": 6, "y": 24, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rec_engine_active_connections",
            "legendFormat": "Active Connections",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5000, "color": "yellow"},
                {"value": 10000, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "SLO Dashboard",
        "type": "table",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rec_engine_slo_latency_p50_seconds",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "rec_engine_slo_latency_p95_seconds",
            "legendFormat": "p95 (SLO: 100ms)",
            "refId": "B"
          },
          {
            "expr": "rec_engine_slo_latency_p99_seconds",
            "legendFormat": "p99",
            "refId": "C"
          },
          {
            "expr": "rec_engine_slo_error_rate",
            "legendFormat": "Error Rate (SLO: <1%)",
            "refId": "D"
          },
          {
            "expr": "rec_engine_slo_availability",
            "legendFormat": "Availability (SLO: 99.9%)",
            "refId": "E"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 11,
        "title": "ANN Index Metrics",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(rec_engine_index_query_latency_seconds_bucket[5m])) by (le, index_type))",
            "legendFormat": "p95 Query - {{index_type}}",
            "refId": "A"
          },
          {
            "expr": "rec_engine_index_size_bytes",
            "legendFormat": "Size - {{index_type}}",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 12,
        "title": "Feature Store Latency",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(rec_engine_feature_latency_seconds_bucket[5m])) by (le, operation, entity_type))",
            "legendFormat": "p95 {{operation}} {{entity_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 13,
        "title": "Queue Depth",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 36, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rec_engine_queue_depth",
            "legendFormat": "{{queue_name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 14,
        "title": "Experiment Assignments",
        "type": "piechart",
        "gridPos": {"x": 12, "y": 36, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(rec_engine_experiment_assignments_total[5m])) by (experiment_id, variant)",
            "legendFormat": "{{experiment_id}} - {{variant}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "reduceOptions": {
              "values": false,
              "calcs": ["lastNotNull"]
            }
          }
        }
      },
      {
        "id": 15,
        "title": "Feedback Distribution",
        "type": "barchart",
        "gridPos": {"x": 0, "y": 44, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(rec_engine_feedback_total[5m])) by (interaction_type)",
            "legendFormat": "{{interaction_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        }
      },
      {
        "id": 16,
        "title": "Model Version",
        "type": "stat",
        "gridPos": {"x": 12, "y": 44, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "rec_engine_model_version",
            "legendFormat": "{{model_name}} v{{version}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"1": {"text": "Active", "color": "green"}}}
            ]
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "endpoint",
          "type": "query",
          "query": "label_values(rec_engine_requests_total, endpoint)",
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "refresh": 1
        },
        {
          "name": "environment",
          "type": "query",
          "query": "label_values(rec_engine_requests_total, environment)",
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "refresh": 1
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "type": "dashboard",
          "datasource": "Prometheus",
          "query": "kube_deployment_status_replicas_updated{namespace=\"rec-engine\"}",
          "enable": true
        }
      ]
    }
  },
  "version": 1,
  "schemaVersion": 38
}